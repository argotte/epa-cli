{
  "name": "epa-cli",
  "version": "0.1.0",
  "description": "CLI para consultar el catálogo de Ferretería EPA Venezuela vía su endpoint GraphQL público",
  "type": "module",
  "bin": {
    "epa": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/prompts": "^7.2.1",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
